# Dart / Pub
.dart_tool/
.packages
build/
pubspec.lock

# Flutter — generated and machine-specific. These embed absolute
# pub-cache paths (/Users/<you>/.pub-cache/...), so committing one leaks
# a local filesystem layout into a public repo. Flutter regenerates them
# on `pub get` and on build; the files say so themselves.
.flutter-plugins
.flutter-plugins-dependencies
**/ios/Flutter/Generated.xcconfig
**/ios/Flutter/flutter_export_environment.sh
**/macos/Flutter/Flutter-Generated.xcconfig
**/ios/Flutter/ephemeral/
**/macos/Flutter/ephemeral/
**/linux/flutter/ephemeral/
**/windows/flutter/ephemeral/

# IDE
*.iml
.idea/
.vscode/
*.code-workspace

# OS
.DS_Store
Thumbs.db

# Local env / secrets — the .env.example files are committed
.env
.env.*
!.env.example

# Logs
*.log

# Firebase
.firebaserc.local
.firebase/

# Cloud Run / Docker scratch
.gcloud/

# Cloud Run / Cloud Functions deploy config — project IDs and
# per-reader values stay local; config.example.sh is the committed
# template.
deploy/cloudrun/config.sh
deploy/functions/config.sh
